      { id: "ci5", cat: "antidepressant", badge: "Antidepressant", badgeColor: "bg-purple-100 text-purple-700", title: "Placeholder: Antidepressant Category", desc: "Ready for custom antidepressant entries.", details: "You can provide custom antidepressants later." }
    ];

    const protos = [
      { id: "p1", cat: "neuro", badge: "Neurocritical Care", badgeColor: "bg-rose-100 text-rose-700", t: "🚨 1. Raised Intracranial Pressure (ICP) & Herniation Tiers", b: `• <b>Targets:</b> ICP &lt; 22 mmHg | CPP 60–70 mmHg | SpO2 &gt; 94%<br>• <b>Tier 1:</b> Mannitol 20% 0.5–1 g/kg IV or Hypertonic Saline 3% 2–5 mL/kg IV.` },
      { id: "p2", cat: "surg", badge: "Trauma Surgery", badgeColor: "bg-rose-100 text-rose-700", t: "🔪 2. ATLS Primary Survey & Massive Transfusion (MTP)", b: `• <b>cABCDE Primary Survey:</b> Exsanguinating hemorrhage -> Airway -> Breathing -> Circulation.<br>• <b>MTP:</b> 1:1:1 PRBC:FFP:Platelets + TXA 1g IV.` },
      { id: "p3", cat: "med", badge: "Endocrine ER", badgeColor: "bg-emerald-100 text-emerald-700", t: "🏥 3. Diabetic Ketoacidosis (DKA) & HHS Protocol", b: `• <b>Fluids:</b> 0.9% NS 1000 mL over 1st hour.<br>• <b>Potassium:</b> Hold insulin if K+ &lt; 3.3 mEq/L; replace KCl.<br>• <b>Insulin:</b> 0.1 units/kg/hr regular insulin infusion.` },
      { id: "p4", cat: "med", badge: "Cardiology ER", badgeColor: "bg-rose-100 text-rose-700", t: "❤️ 4. Acute Coronary Syndrome (STEMI / NSTEMI)", b: `• <b>Loading:</b> Aspirin 300mg chewed + Ticagrelor 180mg PO.<br>• <b>Anticoagulation:</b> UFH bolus or Enoxaparin SC.<br>• <b>Reperfusion:</b> Primary PCI within 90 min.` }
    ];

    function init() {
      document.getElementById('catBar').innerHTML = cats.map(c=>`<button onclick="setCat('${c[0]}')" class="px-3.5 py-1.5 rounded-xl shrink-0 transition shadow-sm ${c[0]===curCat?'bg-sky-600 text-white font-extrabold':'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'}">${c[1]}</button>`).join('');
      document.getElementById('abxCatBar').innerHTML = abxCats.map(c=>`<button onclick="setAbxCat('${c[0]}')" class="px-3.5 py-1.5 rounded-xl shrink-0 transition shadow-sm ${c[0]===curAbxCat?'bg-emerald-600 text-white font-extrabold':'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'}">${c[1]}</button>`).join('');
      document.getElementById('protoCatBar').innerHTML = protoCats.map(c=>`<button onclick="setProtoCat('${c[0]}')" class="px-3.5 py-1.5 rounded-xl shrink-0 transition shadow-sm ${c[0]===curProtoCat?'bg-sky-600 text-white font-extrabold':'bg-white border border-slate-200 text-slate-700 hover:bg-slate-100'}">${c[1]}</button>`).join('');
      
      const today = new Date().toISOString().split('T')[0];
      document.getElementById('rxDate').value = today;
      updateRxPreview();
      calcCrCl(); renderDrugs(); renderAbx(); renderProtos(); calcPump(); calcBurn(); calcAlv(); calcApgar();
    }

    function toggleAcc(id) {
      if (openSet.has(id)) openSet.delete(id);
      else openSet.add(id);
      renderDrugs(); renderAbx(); renderProtos();
    }

    function toggleGroup(group) {
      let ids = [];
      if (group === 'drug') ids = drugs.map(d => d.id);
      if (group === 'abx') ids = catItems.map(i => i.id);
      if (group === 'proto') ids = protos.map(p => p.id);

      const anyOpen = ids.some(id => openSet.has(id));
      ids.forEach(id => {
        if (anyOpen) openSet.delete(id);
        else openSet.add(id);
      });
      renderDrugs(); renderAbx(); renderProtos();
    }

    function setW(v) {
      W = Math.max(2, Math.min(200, parseFloat(v)||70));
      ['wInpMob','wInpSide'].forEach(id => { if(document.getElementById(id)) document.getElementById(id).value = W; });
      ['wRngMob','wRngSide'].forEach(id => { if(document.getElementById(id)) document.getElementById(id).value = Math.min(W,150); });
      document.getElementById('hdrW').innerText = W+' kg';
      document.getElementById('sideWBadge').innerText = W+' kg';
      document.getElementById('pNote').innerText = 'Calculated for Weight: '+W+' kg';
      calcCrCl(); renderDrugs(); renderAbx(); calcPump(); calcBurn();
    }

    function calcCrCl() {
      const age = Math.max(1, parseFloat(document.getElementById('rAge').value) || 50);
      const scr = Math.max(0.2, parseFloat(document.getElementById('rScr').value) || 1.0);
      const sex = parseFloat(document.getElementById('rSex').value) || 1.0;
      CrCl = Math.max(1, Math.round(((140 - age) * W * sex) / (72 * scr)));

      const resEl = document.getElementById('crclResult');
      const stgEl = document.getElementById('crclStage');
      resEl.innerText = `${CrCl} mL/min`;
      document.getElementById('hdrCrCl').innerText = `${CrCl}`;
      document.getElementById('sideCrClBadge').innerText = `${CrCl} mL/min`;

      if (CrCl > 50) {
        resEl.className = "text-lg font-extrabold text-emerald-700";
        stgEl.innerText = "Normal Renal Function (>50)";
      } else if (CrCl >= 20) {
        resEl.className = "text-lg font-extrabold text-amber-700";
        stgEl.innerText = "Moderate Impairment (20–50)";
      } else {
        resEl.className = "text-lg font-extrabold text-rose-700";
        stgEl.innerText = "Severe Renal Failure (<20)";
      }
    }

    function setCat(c) { curCat = c; init(); }
    function setAbxCat(c) {
      curAbxCat = c;
      const titles = {
        'antibiotics': '🦠 Antibiotics Category (Tap to Expand ▼)',
        'analgesia': '💊 Analgesia Category (Tap to Expand ▼)',
        'antihistamine': '🌿 Antihistamine Category (Tap to Expand ▼)',
        'anticoagulant': '🩸 Anticoagulant Category (Tap to Expand ▼)',
        'antidepressant': '🧠 Antidepressant Category (Tap to Expand ▼)'
      };
      document.getElementById('catSectionTitle').innerText = titles[c] || 'Category Items';
      init();
    }
    function setProtoCat(c) { curProtoCat = c; init(); }

    function addRxItem() {
      const name = document.getElementById('rxMedName').value.trim();
      const freq = document.getElementById('rxMedFreq').value.trim();
      const route = document.getElementById('rxMedRoute').value.trim();
      if (!name) { alert('Please enter a medication name.'); return; }
      rxItems.push({ name, freq: freq || 'as directed', route: route || 'oral/IV' });
      document.getElementById('rxMedName').value = '';
      document.getElementById('rxMedFreq').value = '';
      document.getElementById('rxMedRoute').value = '';
      updateRxPreview();
    }

    function removeRxItem(idx) {
      rxItems.splice(idx, 1);
      updateRxPreview();
    }

    function updateRxPreview() {
      const ptName = document.getElementById('rxPtName').value.trim() || 'John Doe (Example)';
      const ptAge = document.getElementById('rxPtAge').value.trim() || '45 / Male';
      const rxDate = document.getElementById('rxDate').value || new Date().toISOString().split('T')[0];
      const rxNotes = document.getElementById('rxNotes').value.trim() || 'Take medications as prescribed. Return if symptoms worsen.';

      document.getElementById('prevName').innerText = ptName;
      document.getElementById('prevAge').innerText = ptAge;
      document.getElementById('prevDate').innerText = rxDate;
      document.getElementById('prevNotes').innerText = rxNotes;

      const listEl = document.getElementById('rxItemsList');
      if (rxItems.length === 0) {
        listEl.innerHTML = `<p class="text-slate-400 italic text-xs">No medications added yet. Use the form on the left to add items.</p>`;
      } else {
        listEl.innerHTML = rxItems.map((item, idx) => `
          <div class="flex justify-between items-center bg-slate-50 p-2 rounded-xl border border-slate-200">
            <div>
              <div class="font-extrabold text-slate-900">${idx + 1}. ${item.name}</div>
              <div class="text-slate-600">${item.freq} — <span class="italic text-sky-700">${item.route}</span></div>
            </div>
            <button onclick="removeRxItem(${idx})" class="text-rose-600 hover:text-rose-800 text-xs font-bold px-2 py-1 bg-rose-50 rounded-lg border border-rose-200">Remove</button>
          </div>
        `).join('');
      }
    }

    // Attach listeners for dynamic Rx preview update
    ['rxPtName', 'rxPtAge', 'rxDate', 'rxNotes'].forEach(id => {
      document.getElementById(id).addEventListener('input', updateRxPreview);
    });

    function printRx() {
      const content = document.getElementById('rxPreviewSheet').innerHTML;
      const win = window.open('', '', 'height=700,width=700');
      win.document.write('<html><head><title>Prescription</title>');
      win.document.write('<script src="https://cdn.tailwindcss.com"><\/script>');
      win.document.write('</head><body class="p-8 bg-white">');
      win.document.write(content);
      win.document.write('</body></html>');
      win.document.close();
      win.focus();
      setTimeout(() => { win.print(); }, 500);
    }

    function renderDrugs() {
      const q = (document.getElementById('dSearch').value||'').toLowerCase().trim();
      const list = drugs.filter(d => (curCat==='all'||d.c===curCat) && (!q || d.n.toLowerCase().includes(q) || d.t.toLowerCase().includes(q)));
      document.getElementById('drugsList').innerHTML = list.map(d => {
        const isOpen = openSet.has(d.id) || q.length > 1;
        return `
        <div class="card overflow-hidden transition border ${isOpen ? 'border-sky-500 shadow-md' : 'border-slate-200'}">
          <button onclick="toggleAcc('${d.id}')" class="w-full p-3.5 text-left flex justify-between items-center gap-2 bg-slate-50 hover:bg-slate-100 transition">
            <div class="min-w-0">
              <b class="text-xs md:text-sm text-slate-900 block truncate">${d.n}</b>
              <span class="text-[10px] text-sky-600 font-semibold">${d.t}</span>
            </div>
            <span class="w-7 h-7 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-sky-600 text-xs font-bold shrink-0 shadow-sm">
              ${isOpen ? '▲' : '▼'}
            </span>
          </button>
          <div class="${isOpen ? 'block' : 'hidden'} p-3.5 border-t border-slate-200 bg-white space-y-2 text-xs">
            <div class="bg-slate-50 p-2.5 rounded-xl border border-slate-200 leading-relaxed text-slate-800">${d.f(W)}</div>
            <p class="text-[11px] text-amber-900 bg-amber-50 border border-amber-200 p-2 rounded-lg">💡 <b>Clinical Pearl:</b> ${d.i}</p>
          </div>
        </div>`;
      }).join('');
    }

    function renderAbxCard(i, q) {
      const isOpen = openSet.has(i.id) || q.length > 1;
      const bodyHtml = i.adult ? `
        <div class="grid grid-cols-1 md:grid-cols-2 gap-2.5 text-xs">
          <div class="bg-sky-50/70 p-3 rounded-xl border border-sky-200 space-y-1">
            <div class="text-[11px] font-extrabold text-sky-800">🧑 Adult Dose:</div>
            <div class="text-slate-800 leading-relaxed">${i.adult(W)}</div>
          </div>
          <div class="bg-emerald-50/70 p-3 rounded-xl border border-emerald-200 space-y-1">
            <div class="text-[11px] font-extrabold text-emerald-800">👶 Pediatric Dose (${W} kg):</div>
            <div class="text-slate-800 leading-relaxed">${i.peds(W)}</div>
          </div>
        </div>
      ` : `
        <p class="text-slate-700">${i.desc}</p>
        <div class="bg-slate-50 p-3 rounded-xl border border-slate-200 text-slate-600">📌 <b>Status:</b> ${i.details}</div>
      `;
      return `
      <div class="card overflow-hidden border ${isOpen ? 'border-emerald-500 shadow-md' : 'border-slate-200'}">
        <button onclick="toggleAcc('${i.id}')" class="w-full p-3.5 text-left flex justify-between items-center gap-2 bg-slate-50 hover:bg-slate-100 transition">
          <div class="space-y-1">
            <span class="text-[10px] ${i.badgeColor} px-2 py-0.5 rounded-full font-bold inline-block">${i.badge}</span>
            <h3 class="font-extrabold text-xs md:text-sm text-slate-900 leading-snug">${i.title}</h3>
          </div>
          <span class="w-7 h-7 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-emerald-600 text-xs font-bold shrink-0 shadow-sm">
            ${isOpen ? '▲' : '▼'}
          </span>
        </button>
        <div class="${isOpen ? 'block' : 'hidden'} p-3.5 border-t border-slate-200 bg-white space-y-2.5 text-xs">
          ${bodyHtml}
        </div>
      </div>`;
    }

    function renderAbx() {
      const q = (document.getElementById('abxSearch').value||'').toLowerCase().trim();
      const list = catItems.filter(i => i.cat===curAbxCat && (!q || i.title.toLowerCase().includes(q)));
      
      if (curAbxCat === 'antibiotics') {
        const ivList = list.filter(i => i.sub === 'iv');
        const oralList = list.filter(i => i.sub === 'oral');
        document.getElementById('abxList').innerHTML = `
          <div class="space-y-2.5">
            <div class="flex items-center gap-2 border-b border-emerald-200 pb-1.5">
              <span class="text-sm">💉</span>
              <h4 class="text-xs md:text-sm font-extrabold text-emerald-800 uppercase tracking-wide">1. IV Antibiotics (Intravenous)</h4>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5 items-start">
              ${ivList.map(i => renderAbxCard(i, q)).join('')}
            </div>
          </div>
          <div class="space-y-2.5 pt-2">
            <div class="flex items-center gap-2 border-b border-teal-200 pb-1.5">
              <span class="text-sm">💊</span>
              <h4 class="text-xs md:text-sm font-extrabold text-teal-800 uppercase tracking-wide">2. Oral Antibiotics (PO)</h4>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5 items-start">
              ${oralList.map(i => renderAbxCard(i, q)).join('')}
            </div>
          </div>
        `;
      } else {
        document.getElementById('abxList').innerHTML = `
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5 items-start">
            ${list.map(i => renderAbxCard(i, q)).join('')}
          </div>
        `;
      }
    }

    function renderProtos() {
      const q = (document.getElementById('pSearch').value||'').toLowerCase().trim();
      const filtered = protos.filter(p => (curProtoCat==='all' || p.cat===curProtoCat) && (!q || p.t.toLowerCase().includes(q)));
      document.getElementById('protoList').innerHTML = filtered.map(p => {
        const isOpen = openSet.has(p.id) || q.length > 1;
        return `
        <div class="card overflow-hidden border ${isOpen ? 'border-sky-500 shadow-md' : 'border-slate-200'}">
          <button onclick="toggleAcc('${p.id}')" class="w-full p-3.5 text-left flex justify-between items-center gap-2 bg-slate-50 hover:bg-slate-100 transition">
            <div class="space-y-1">
              <span class="text-[10px] ${p.badgeColor} px-2.5 py-0.5 rounded-full font-bold inline-block">${p.badge}</span>
              <h3 class="font-extrabold text-xs md:text-sm text-slate-900">${p.t}</h3>
            </div>
            <span class="w-7 h-7 rounded-lg bg-white border border-slate-200 flex items-center justify-center text-sky-600 text-xs font-bold shrink-0 shadow-sm">
              ${isOpen ? '▲' : '▼'}
            </span>
          </button>
          <div class="${isOpen ? 'block' : 'hidden'} p-3.5 border-t border-slate-200 bg-white text-slate-800 leading-relaxed text-xs">
            ${p.b}
          </div>
        </div>`;
      }).join('');
    }

    function calcGCS() {
      const e=+document.getElementById('gcsE').value, v=+document.getElementById('gcsV').value, m=+document.getElementById('gcsM').value;
      const tot = e+v+m;
      document.getElementById('gcsOut').innerText = `${tot}/15 (E${e} V${v} M${m})`;
      const note = document.getElementById('gcsNote');
      if(tot>=13) { note.innerText="Mild Brain Injury (13–15)"; note.className="bg-emerald-50 border border-emerald-200 p-2.5 rounded-xl text-center text-emerald-700 font-bold"; }
      else if(tot>=9) { note.innerText="Moderate Brain Injury (9–12)"; note.className="bg-amber-50 border border-amber-200 p-2.5 rounded-xl text-center text-amber-700 font-bold"; }
      else { note.innerText="Severe Brain Injury / Coma (≤8)"; note.className="bg-rose-50 border border-rose-200 p-2.5 rounded-xl text-center text-rose-700 font-bold"; }
    }

    function copyGCS() { navigator.clipboard.writeText('GCS ' + document.getElementById('gcsOut').innerText); alert('GCS Copied to Clipboard!'); }

    function calcAlv() {
      let score = 0;
      document.querySelectorAll('.alv-chk:checked').forEach(el => score += parseInt(el.value));
      document.getElementById('alvScore').innerText = `${score} / 10`;
      const note = document.getElementById('alvOut');
      if (score >= 7) { note.innerText = `Score ${score}: Probable Appendicitis`; note.className = "bg-rose-50 border border-rose-200 p-2.5 rounded-xl text-center text-rose-700 font-bold text-xs"; }
      else if (score >= 5) { note.innerText = `Score ${score}: Possible Appendicitis`; note.className = "bg-amber-50 border border-amber-200 p-2.5 rounded-xl text-center text-amber-800 font-bold text-xs"; }
      else { note.innerText = `Score ${score}: Appendicitis Unlikely`; note.className = "bg-slate-50 border border-slate-200 p-2.5 rounded-xl text-center text-slate-700 font-bold text-xs"; }
    }

    function calcApgar() {
      const tot = +document.getElementById('apA').value + +document.getElementById('apP').value + +document.getElementById('apG').value + +document.getElementById('apAc').value + +document.getElementById('apR').value;
      document.getElementById('apgarOut').innerText = `${tot} / 10`;
      const note = document.getElementById('apgarNote');
      if (tot >= 7) { note.innerText = `APGAR ${tot}: Normal Status`; note.className = "bg-emerald-50 border border-emerald-200 p-2 rounded-xl text-center text-emerald-700 font-bold text-[11px]"; }
      else if (tot >= 4) { note.innerText = `APGAR ${tot}: Moderate Depression`; note.className = "bg-amber-50 border border-amber-200 p-2 rounded-xl text-center text-amber-800 font-bold text-[11px]"; }
      else { note.innerText = `APGAR ${tot}: Severe Depression!`; note.className = "bg-rose-50 border border-rose-200 p-2 rounded-xl text-center text-rose-700 font-bold text-[11px]"; }
    }

    function calcABC() {
      const v = ((+document.getElementById('abA').value)*(+document.getElementById('abB').value)*(+document.getElementById('abC').value))/2;
      document.getElementById('abcOut').innerText = `Volume: ${v.toFixed(1)} mL (cm³) ${v>=30?'⚠️ Critical (≥30mL)':''}`;
    }

    function calcICH() {
      const s = (+document.getElementById('icG').value)+(+document.getElementById('icV').value)+(+document.getElementById('icI').value)+(+document.getElementById('icF').value)+(+document.getElementById('icA').value);
      const m = ['0%','13%','26%','72%','97%','100%','100%'][s];
      document.getElementById('ichOut').innerText = `ICH Score: ${s}/6 (30-Day Mort: ${m})`;
    }

    function calcBurn() {
      const tbsa = Math.max(1, Math.min(100, parseFloat(document.getElementById('burnTbsa').value)||20));
      const total = Math.round(4 * W * tbsa);
      const half = Math.round(total / 2);
      document.getElementById('burnOut').innerHTML = `
        <div class="text-sm font-extrabold text-slate-900">Total 24h: ${total} mL LR</div>
        <div class="text-xs text-sky-700 font-bold">1st 8h: ${half} mL (${Math.round(half/8)} mL/hr)</div>
        <div class="text-[11px] text-slate-500">Next 16h: ${half} mL (${Math.round(half/16)} mL/hr)</div>
      `;
    }

    function setPump() {
      const p = document.getElementById('pPre').value.split(',');
      document.getElementById('pMg').value=p[0]; document.getElementById('pMl').value=p[1]; document.getElementById('pDs').value=p[2]; pMode=+p[3]; calcPump();
    }

    function calcPump() {
      const mg=+document.getElementById('pMg').value||1, ml=+document.getElementById('pMl').value||1, ds=+document.getElementById('pDs').value||0;
      const rate = pMode===1 ? (ds*W*60)/((mg*1000)/ml) : (pMode===2 ? (ds*W)/(mg/ml) : (ds*W)/((mg*1000)/ml));
      document.getElementById('pOut').innerText = `${rate.toFixed(1)} mL/hr`;
    }

    function tab(t) {
      const sections = ['dosing','abx','rx','protocols','scales','pump'];
      if (t === 'all') {
        sections.forEach(x => document.getElementById('tab-'+x).classList.remove('hidden'));
      } else {
        sections.forEach(x => document.getElementById('tab-'+x).classList.add('hidden'));
        document.getElementById('tab-'+t).classList.remove('hidden');
      }
      sections.forEach(x => {
        const mobBtn = document.getElementById('n-'+x);
        if(mobBtn) mobBtn.className = (x===t) ? "py-2 flex flex-col items-center active-mob" : "py-2 flex flex-col items-center text-slate-500";
      });
      [...sections, 'all'].forEach(x => {
        const sideBtn = document.getElementById('s-'+x);
        if(sideBtn) sideBtn.className = (x===t)
          ? "w-full p-3 rounded-xl border border-transparent flex items-center gap-3 text-left transition active-side"
          : "w-full p-3 rounded-xl border border-slate-200 flex items-center gap-3 text-left text-slate-700 hover:bg-slate-100 transition";
      });
    }

    init();
  </script>
</body>
</html>
