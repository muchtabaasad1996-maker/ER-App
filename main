      { id: "ab_po1", cat: "antibiotics", sub: "oral", badge: "Oral Antibiotic", badgeColor: "bg-teal-100 text-teal-800", title: "Placeholder: Oral Antibiotics Section", desc: "Ready for your custom oral (PO) antibiotic medication entries.", details: "Provide your list of oral antibiotics to populate this section." },
      { id: "ci2", cat: "analgesia", badge: "Analgesia", badgeColor: "bg-sky-100 text-sky-700", title: "Placeholder: Analgesia Category", desc: "Ready for custom analgesic and pain management medication entries.", details: "You can provide custom analgesics later." },
      { id: "ci3", cat: "antihistamine", badge: "Antihistamine", badgeColor: "bg-teal-100 text-teal-800", title: "Placeholder: Antihistamine Category", desc: "Ready for custom antihistamine and allergic reaction entries.", details: "You can provide custom antihistamines later." },
